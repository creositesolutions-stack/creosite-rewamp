OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-4o-mini

APP_ENV=development

# LangSmith tracing (server-side only)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=creosite-chatbot
LANGSMITH_TRACING_PRIVACY=REDACTED
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Supabase persistence (server-side only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
VISITOR_COOKIE_SECRET=replace_with_a_long_random_secret
CONVERSATION_RETENTION_DAYS=365

RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL="Creosite <noreply@yourdomain.com>"
CONTACT_TO_EMAIL=you@yourdomain.com

# Cloudflare Turnstile (spam protection for contact + AI idea forms)
# Leave empty to disable locally; both values are required in production.
VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key_here
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here

VITE_CONTACT_EMAIL=hello@creosite.com
VITE_CONTACT_PHONE=+91 00000 00000
VITE_CONTACT_WHATSAPP=910000000000
VITE_CONTACT_HOURS=Mon–Sat, 10am–7pm IST
